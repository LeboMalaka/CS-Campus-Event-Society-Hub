PORT=5002
NODE_ENV=development
# Set this to your Neon PostgreSQL connection string. Keep the real value in .env only.
DATABASE_URL=postgresql://username:password@host.neon.tech:5432/neondb?sslmode=require
# Replace with a long, random secret. Never expose this value to the browser.
JWT_SECRET=replace_with_a_secure_random_string
JWT_EXPIRES_IN=7d
# Production frontend origin(s), comma-separated when multiple; include scheme and no path.
CLIENT_URL=https://your-frontend-domain.example.com
# Optional additional production frontend origins, e.g. https://app.example.com,https://preview.example.com
CORS_ORIGINS=
